<Window x:Class="SmartBench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智控工作台" Icon="/Assets/smartbench-icon.ico" Height="820" Width="1360" MinHeight="680" MinWidth="1060"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="238" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0C1B31">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Margin="26,27,22,26">
          <StackPanel Orientation="Horizontal">
            <Border Width="42" Height="42" CornerRadius="11" Background="#173B68"><Image Source="/Assets/smartbench-icon.png" Stretch="Uniform" Margin="2" /></Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center"><TextBlock Text="智控工作台" Foreground="White" FontSize="17" FontWeight="Bold" /><TextBlock Text="SMART BENCH · PROFESSIONAL" Foreground="#8EA2C0" FontSize="9" FontWeight="SemiBold" /></StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Margin="12,0,12,0">
          <TextBlock Text="工作模块" Foreground="#6E83A2" FontSize="11" FontWeight="SemiBold" Margin="14,0,0,9" />
          <Button x:Name="TtsNavigation" Tag="tts" Click="Navigate_Click" HorizontalContentAlignment="Left" Padding="15,13" Margin="0,0,0,5" Foreground="White" Background="#18345A" BorderBrush="#18345A"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="18" Margin="0,-3,12,0" /><StackPanel><TextBlock Text="文本转语音" FontSize="14" /><TextBlock Text="语速、音色与输出控制" Foreground="#91A5C5" FontSize="10" FontWeight="Normal" /></StackPanel></StackPanel></Button>
          <Button x:Name="CommunicationNavigation" Tag="communication" Click="Navigate_Click" HorizontalContentAlignment="Left" Padding="15,13" Margin="0,0,0,5" Foreground="#C9D5E9" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal"><TextBlock Text="↔" FontSize="20" Margin="0,-4,12,0" /><StackPanel><TextBlock Text="通讯调试" FontSize="14" /><TextBlock Text="RS232、Modbus、UDP" Foreground="#7F94B3" FontSize="10" FontWeight="Normal" /></StackPanel></StackPanel></Button>
          <Button x:Name="UsbNavigation" Tag="usb" Click="Navigate_Click" HorizontalContentAlignment="Left" Padding="15,13" Foreground="#C9D5E9" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="17" Margin="1,-2,12,0" /><StackPanel><TextBlock Text="U 盘批量下发" FontSize="14" /><TextBlock Text="识别、选择与完整文件复制" Foreground="#7F94B3" FontSize="10" FontWeight="Normal" /></StackPanel></StackPanel></Button>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Margin="20" Padding="13" Background="#112846" CornerRadius="10"><StackPanel><TextBlock Text="安全运行模式" Foreground="#DDE8F9" FontWeight="SemiBold" FontSize="12" /><StackPanel Orientation="Horizontal" Margin="0,4,0,0"><TextBlock Text="普通用户权限 · 本机离线运行 ·" Foreground="#8EA2C0" FontSize="10" /><TextBlock x:Name="VersionText" Text="v0.7.0" Foreground="#8EA2C0" FontSize="10" Margin="4,0,0,0" /></StackPanel></StackPanel></Border>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#E7ECF3" BorderThickness="0,0,0,1"><DockPanel Margin="30,0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="文本转语音" FontSize="19" FontWeight="Bold" /><TextBlock x:Name="PageSubtitle" Text="将文字自然地转换为本机语音" Foreground="#69788C" FontSize="11" Margin="0,3,0,0" /></StackPanel><Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="10,5" Background="#F0F8F4" CornerRadius="15"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#16A36A" Margin="0,0,6,0" /><TextBlock Text="本机离线运行" FontSize="11" Foreground="#168155" /></StackPanel></Border></DockPanel></Border>
      <ContentControl x:Name="PageHost" Grid.Row="1" />
    </Grid>
  </Grid>
</Window>
