<UserControl x:Class="SmartBench.Views.UsbTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:SmartBench.Services"
             Background="#F5F7FB"
             FontSize="13"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">
  <UserControl.Resources>
    <services:StringNotEmptyConverter x:Key="StringNotEmpty" />
    <Style TargetType="Button">
      <Setter Property="Padding" Value="11,6" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="GridCheck" TargetType="CheckBox">
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="LayoutTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1.35" ScaleY="1.35" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#44506A" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Background" Value="#FBFCFE" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <!-- 设备区、文件区、任务区三块按比例分配剩余高度，中间用分隔条隔开（必须隔开，
           否则多个 * 行会分到重叠位置）。表格自身填满所属区块并在内部滚动。 -->
      <RowDefinition Height="1*" MinHeight="130" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.2*" MinHeight="150" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="1.15*" MinHeight="200" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FFF7E8" BorderBrush="#F2D8A5" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="!" Foreground="White" FontWeight="Bold" TextAlignment="Center" Background="#E39119" Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" x:Name="UsbHintText" VerticalAlignment="Center" Foreground="#6B4E15" FontSize="12" TextWrapping="Wrap" Text="未挂载或提示格式化的 U 盘不能选择下发；可使用每行“格式化”按钮调出 Windows 格式化对话框处理该设备。" />
        <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Padding="10,4" FontSize="12" Margin="10,0,0,0" Click="RefreshDrives_Click">刷新设备</Button></StackPanel>
      </Grid>
    </Border>

    <!-- 设备区 -->
    <Border x:Name="DrivePanel" Grid.Row="1" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="12" Padding="14,11" VerticalAlignment="Stretch">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="U 盘设备" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" x:Name="DriveSummary" Text="正在检查设备…" Foreground="#56637B" FontSize="12.5" VerticalAlignment="Center" Margin="10,0,0,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Padding="8,4" FontSize="12" Click="SelectAllDrives_Click">全选</Button>
              <Button Padding="8,4" FontSize="12" Margin="6,0,0,0" Click="ClearDriveSelection_Click">清空选择</Button>
              <Button Padding="8,4" FontSize="12" Margin="6,0,0,0" Background="#FFF1F0" BorderBrush="#E8B4B0" Click="BatchFormat_Click" ToolTip="对勾选的全部 U 盘执行快速格式化">批量格式化</Button>
              <CheckBox x:Name="AutoFormatCheck" Content="需格式化时自动处理" VerticalAlignment="Center" Margin="12,0,8,0" FontSize="12" Cursor="Hand" Checked="SettingCheck_Changed" Unchecked="SettingCheck_Changed" ToolTip="开启后，插入无法读取（提示需格式化）的 U 盘时，本软件自动执行快速格式化，文件系统默认 FAT32（容量大于 32GB 时使用 exFAT）。数据将全部清除，请确认后再开启。" />
              <Border Background="#ECF2FF" Padding="9,4" CornerRadius="12" VerticalAlignment="Center"><TextBlock Text="最多 10 个" Foreground="#246BFD" FontSize="12" FontWeight="SemiBold"/></Border>
            </StackPanel>
          </DockPanel>
          <!-- 设备表格：填满设备区剩余高度，设备多时表格内部滚动 -->
          <DataGrid x:Name="DriveGrid" Grid.Row="1" ItemsSource="{Binding Drives}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6" BorderBrush="#EEF1F6" BorderThickness="1" IsReadOnly="False" RowHeight="32" FontSize="13" ColumnHeaderStyle="{StaticResource GridHeader}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="下发" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource GridCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="勾选后用于批量下发或批量格式化" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              <DataGridTextColumn Header="盘符" Width="60" Binding="{Binding RootPath}" IsReadOnly="True" />
              <DataGridTextColumn Header="设备名称" Width="*" Binding="{Binding Label}" IsReadOnly="True" />
              <DataGridTextColumn Header="状态" Width="130" Binding="{Binding State}" IsReadOnly="True" />
              <DataGridTextColumn Header="可用空间" Width="110" Binding="{Binding FreeSpaceText}" IsReadOnly="True" />
              <DataGridTemplateColumn Header="格式化" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="格式化" Padding="7,3" FontSize="12" Click="FormatDrive_Click" ToolTip="调出 Windows 格式化对话框，清空该 U 盘全部数据" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>

      <!-- 分隔条：拖动可调整设备区与文件区的高度比例 -->
      <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" Margin="0,4,0,4" />

      <Border x:Name="FilePanel" Grid.Row="3" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="12" Padding="14,12" VerticalAlignment="Stretch" MinHeight="150">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="选择文件" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Padding="8,4" FontSize="12" Click="SelectAllFiles_Click">全选 / 反选</Button>
              <Button Padding="8,4" FontSize="12" Margin="6,0,0,0" Click="RemoveSelectedFiles_Click">移除选中</Button>
              <Button Padding="8,4" FontSize="12" Margin="10,0,0,0" Click="AddFiles_Click">添加文件</Button>
              <Button Padding="8,4" FontSize="12" Margin="6,0,0,0" Click="AddFolder_Click">选择文件夹</Button>
              <Button Padding="8,4" FontSize="12" Margin="6,0,0,0" Click="ClearUpload_Click">清空内容</Button>
            </StackPanel>
          </DockPanel>

          <Border x:Name="DropSurface" Grid.Row="1" Margin="0,0,0,8" BorderBrush="#AFC7FF" BorderThickness="1.5" Background="#F5F8FF" CornerRadius="9" AllowDrop="True" DragEnter="DropSurface_DragEnter" DragLeave="DropSurface_DragLeave" DragOver="DropSurface_DragOver" Drop="DropSurface_Drop">
            <DockPanel Margin="10,2">
              <TextBlock x:Name="TransferSummary" DockPanel.Dock="Right" Text="拖入文件或文件夹，支持任意格式并保留目录层级" Foreground="#56637B" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="20" Height="20" Background="#DDE8FF" CornerRadius="10" Margin="0,0,8,0"><TextBlock Text="↓" Foreground="#246BFD" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <TextBlock Text="拖拽任意文件或文件夹到这里" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- 文件清单：填满文件区剩余高度，文件多时表格内部滚动；无文件时显示空状态提示 -->
          <Grid Grid.Row="2">
            <DataGrid x:Name="TransferFileGrid" ItemsSource="{Binding TransferFiles}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F6" BorderBrush="#E7ECF3" BorderThickness="1" RowHeight="31" FontSize="13" ColumnHeaderStyle="{StaticResource GridHeader}" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="下发" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox Style="{StaticResource GridCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="勾选的文件才会被下发" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="文件路径" Width="*" Binding="{Binding DisplayPath}" IsReadOnly="True" />
                <DataGridTextColumn Header="大小" Width="100" Binding="{Binding SizeText}" IsReadOnly="True" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="TransferEmptyHint" Text="尚未添加文件 —— 点击“添加文件”或把文件拖到上方区域" Foreground="#8A97AD" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,18,0,0" IsHitTestVisible="False" />
          </Grid>
        </Grid>
      </Border>

    <!-- 分隔条：拖动可调整文件区与任务区（任务日志）的高度比例 -->
    <GridSplitter Grid.Row="4" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" Margin="0,4,0,4" />

    <!-- 任务区：进度摘要 + 任务日志。任务区按比例分配高度，日志面板撑满其内部 -->
    <Border x:Name="TaskPanel" Grid.Row="5" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,0" VerticalAlignment="Stretch">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 进度摘要行 -->
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <DockPanel>
              <TextBlock Text="任务进度" FontSize="13" FontWeight="SemiBold"/>
              <TextBlock x:Name="TransferStatus" Text="等待选择设备与内容" DockPanel.Dock="Right" Foreground="#56637B" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="TransferTimeText" Text="" Foreground="#56637B" FontSize="11.5" Margin="0,5,0,0"/>
            <ProgressBar x:Name="TransferProgress" Height="8" Margin="0,5,0,0" Minimum="0" Maximum="100" Value="0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
            <Button x:Name="CancelTransferButton" Padding="12,7" Margin="0,0,8,0" IsEnabled="False" Click="CancelTransferButton_Click">取消</Button>
            <Button x:Name="StartTransferButton" Style="{StaticResource PrimaryButton}" Padding="16,7" Click="StartTransferButton_Click">批量下发</Button>
          </StackPanel>
        </Grid>

        <!-- 任务日志面板：撑满任务区剩余高度，内容多时内部滚动；上边缘可拖动 -->
        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeDirection="Rows" Margin="0,3,0,3" />
        <Border Grid.Row="2" x:Name="TaskLogPanel" MinHeight="34" VerticalAlignment="Stretch" Margin="0,0,0,0" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="8" Background="#FAFBFD">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel x:Name="TaskLogHeader" Grid.Row="0" Margin="11,6,11,4">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Padding="9,3" FontSize="11.5" Margin="0,0,6,0" Click="SaveTaskLog_Click">导出</Button>
                <Button Padding="9,3" FontSize="11.5" Click="ClearTaskLog_Click">清空</Button>
                <Button x:Name="ToggleTaskLogButton" Padding="9,3" FontSize="11.5" Margin="6,0,0,0" Click="ToggleTaskLog_Click">展开</Button>
              </StackPanel>
              <TextBlock Text="任务日志" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="TaskLogSummary" DockPanel.Dock="Right" Foreground="#69788C" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" Text=""/>
            </DockPanel>
            <ListBox x:Name="TaskLogList" Grid.Row="1" Margin="4,0,4,4" Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding TaskLogEntries}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Padding" Value="6,2" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="row" Background="Transparent" CornerRadius="4" Padding="6,2">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="#EEF3FB" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11.5" Foreground="#8A97AD" VerticalAlignment="Top" MinWidth="58"/>
                    <Border Grid.Column="1" Margin="8,0,8,0" CornerRadius="3" Padding="5,0" VerticalAlignment="Top">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#EEF1F6" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="Success"><Setter Property="Background" Value="#E3F5EC" /></DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Background" Value="#FDF1DF" /></DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Background" Value="#FCE9E7" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#5A6880" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Level}" Value="Success"><Setter Property="Foreground" Value="#12805A" /></DataTrigger>
                              <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="Foreground" Value="#A96A0E" /></DataTrigger>
                              <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="Foreground" Value="#C0392B" /></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#6E7C92" TextWrapping="Wrap" Margin="0,1,0,0"
                                 Visibility="{Binding Detail, Converter={StaticResource StringNotEmpty}}"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
