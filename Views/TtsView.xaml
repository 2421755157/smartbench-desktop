<UserControl x:Class="SmartBench.Views.TtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
  <Grid Margin="28,24,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部说明条 -->
    <Border Grid.Row="0" Background="#ECF2FF" Padding="16,12" CornerRadius="10" Margin="0,0,0,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Border Width="19" Height="19" CornerRadius="10" Background="#246BFD" Margin="0,0,10,0">
            <TextBlock Text="i" TextAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
          </Border>
          <TextBlock VerticalAlignment="Center" Foreground="#38527B" FontSize="12" TextWrapping="Wrap"
                     Text="完全离线处理。MP3 使用 Windows 内置编码器；dBFS 表示软件信号电平，不代表实际扬声器声压。"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Foreground="#246BFD" FontSize="11" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="16,0,0,0" Text="系统语音 · 本机导出"/>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="355"/>
      </Grid.ColumnDefinitions>

      <!-- 文本编辑器 -->
      <Border Grid.Column="0" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="14" Margin="0,0,20,0">
        <Grid Margin="22">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="文本编辑器" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="CharacterCount" Foreground="#69788C" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Padding="10,5" Margin="0,0,7,0" Click="ImportTextButton_Click">导入 TXT</Button>
                <Button Padding="10,5" Click="ClearTextButton_Click">清空</Button>
              </StackPanel>
            </Grid>
            <!-- 副标题单独占一行，避免被右侧按钮挤成窄条 -->
            <TextBlock Text="支持中英文与数字，可导入 TXT 后分段试听。"
                       Foreground="#69788C" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>

          <TextBox x:Name="SpeechText" Grid.Row="1" Margin="0,18,0,16" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" FontSize="15" TextChanged="SpeechText_TextChanged"
                   Text="欢迎使用智控工作台。这里可以调节语速、音色与输出音量，然后即时试听。"/>

          <!-- 播放控制：只放与试听直接相关的按钮，预设挪到右侧声音设置里 -->
          <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="SpeakButton" Style="{StaticResource PrimaryButton}" Click="SpeakButton_Click" Margin="0,0,9,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="▶" Margin="0,0,7,0"/>
                <TextBlock Text="开始试听"/>
              </StackPanel>
            </Button>
            <Button Click="PauseButton_Click" Margin="0,0,9,0">暂停 / 继续</Button>
            <Button Click="StopButton_Click">停止</Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 右栏内容较高，窗口偏矮时整体滚动，保证导出按钮与状态卡始终可达 -->
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
      <StackPanel>
        <!-- 声音设置 -->
        <Border Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,0,0,11">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="声音设置" FontSize="15" FontWeight="Bold"/>
              <TextBlock Grid.Column="1" x:Name="VoiceCulture" Foreground="#246BFD" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock Text="选择当前电脑可用的系统语音" Foreground="#69788C" FontSize="11" Margin="0,4,0,13"/>

            <TextBlock Text="音色" FontWeight="SemiBold" FontSize="12"/>
            <ComboBox x:Name="VoiceSelector" Margin="0,6,0,14" SelectionChanged="VoiceSelector_SelectionChanged"/>

            <Grid Margin="0,0,0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="语速" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" x:Name="RateValue" Text="正常" Foreground="#246BFD" FontSize="12"/>
            </Grid>
            <Slider x:Name="RateSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RateSlider_ValueChanged"/>

            <Grid Margin="0,12,0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="音高" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" x:Name="PitchValue" Text="0%" Foreground="#246BFD" FontSize="12"/>
            </Grid>
            <Slider x:Name="PitchSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="10" ValueChanged="PitchSlider_ValueChanged"/>

            <Grid Margin="0,12,0,3">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="输出音量" FontWeight="SemiBold" FontSize="12"/>
              <TextBlock Grid.Column="1" x:Name="VolumeValue" Text="100% · 0.0 dBFS" Foreground="#246BFD" FontSize="12"/>
            </Grid>
            <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" ValueChanged="VolumeSlider_ValueChanged"/>

            <!-- 快速预设：本质是同时改语速/音高/音量，放在参数区更顺手；单行排布省高度 -->
            <Border Background="#F7F9FD" CornerRadius="9" Padding="11,8" Margin="0,13,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="快速预设" Foreground="#69788C" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <UniformGrid Grid.Column="1" Columns="3">
                  <Button Padding="8,4" Margin="0,0,4,0" Click="NaturalPreset_Click" ToolTip="接近日常说话：语速稍快、音高略高、音量满档">自然</Button>
                  <Button Padding="8,4" Margin="0,0,4,0" Click="AnnouncePreset_Click" ToolTip="站台播报风格：语速放慢、音高略低、音量满档">播报</Button>
                  <Button Padding="8,4" Click="SlowPreset_Click" ToolTip="慢速朗读：适合校对长句与专有名词">慢速</Button>
                </UniformGrid>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- 导出音频 -->
        <Border Background="White" BorderBrush="#DCE7FF" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,11">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="导出音频" FontSize="15" FontWeight="Bold"/>
                <TextBlock Text="默认输出 MP3；WAV 适合无损保存或二次处理"
                           Foreground="#69788C" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Border Grid.Column="1" Background="#ECF2FF" Padding="8,4" CornerRadius="10" VerticalAlignment="Top">
                <TextBlock Text="离线" Foreground="#246BFD" FontSize="10" FontWeight="SemiBold"/>
              </Border>
            </Grid>

            <Grid Margin="0,11,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="格式" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="ExportFormatSelector" SelectedIndex="0" SelectionChanged="ExportFormatSelector_SelectionChanged">
                  <ComboBoxItem Content="MP3"/>
                  <ComboBoxItem Content="WAV"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="MP3 比特率" Style="{StaticResource Caption}"/>
                <ComboBox x:Name="Mp3BitrateSelector" SelectedIndex="1">
                  <ComboBoxItem Content="64 kbps"/>
                  <ComboBoxItem Content="96 kbps"/>
                  <ComboBoxItem Content="128 kbps"/>
                  <ComboBoxItem Content="192 kbps"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <TextBlock x:Name="ExportHint" Text="96 kbps 单声道：语音清晰、文件体积适中"
                       Foreground="#69788C" FontSize="10" Margin="0,0,0,10" TextWrapping="Wrap"/>
            <Button x:Name="ExportAudioButton" Style="{StaticResource PrimaryButton}" Click="ExportAudioButton_Click">导出 MP3 音频</Button>
          </StackPanel>
        </Border>

        <!-- 状态 -->
        <Border Background="#10233F" CornerRadius="14" Padding="15">
          <StackPanel>
            <TextBlock Text="试听与导出状态" Foreground="#9AAFD0" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock x:Name="PlaybackStatus" Text="准备就绪" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,7"/>
            <TextBlock Text="导出时会在后台生成音频，试听不会被中断。" Foreground="#B7C5DA" FontSize="11" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- 底部状态条 -->
    <Border Grid.Row="2" Margin="0,18,0,0" Padding="13,10" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Ellipse Width="8" Height="8" Fill="#16A36A" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Text="本机语音与编码服务就绪" FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="MP3 为有损格式；WAV 保留 PCM 音频" Foreground="#69788C" FontSize="11"
                   VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
