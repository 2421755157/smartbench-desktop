<UserControl x:Class="SmartBench.Views.TtsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FB">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#ECF2FF" Padding="16,12" CornerRadius="10" Margin="0,0,0,18">
      <DockPanel><StackPanel Orientation="Horizontal"><Border Width="19" Height="19" CornerRadius="10" Background="#246BFD" Margin="0,0,10,0"><TextBlock Text="i" TextAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="12" VerticalAlignment="Center"/></Border><TextBlock VerticalAlignment="Center" Foreground="#38527B" FontSize="12" Text="完全离线处理。MP3 使用 Windows 内置编码器；dBFS 表示软件信号电平，不代表实际扬声器声压。" /></StackPanel><TextBlock DockPanel.Dock="Right" Foreground="#246BFD" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Text="系统语音 · 本机导出"/></DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="355"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="14" Margin="0,0,20,0">
        <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><StackPanel><TextBlock Text="文本编辑器" FontWeight="Bold" FontSize="16"/><TextBlock Text="支持中文、英文与数字；可导入 TXT，长文本建议按段落拆分后试听。" Foreground="#69788C" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="CharacterCount" Foreground="#69788C" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Padding="10,5" Margin="0,0,7,0" Click="ImportTextButton_Click">导入 TXT</Button><Button Padding="10,5" Click="ClearTextButton_Click">清空</Button></StackPanel></DockPanel>
          <TextBox x:Name="SpeechText" Grid.Row="1" Margin="0,18,0,16" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="15" TextChanged="SpeechText_TextChanged" Text="欢迎使用智控工作台。这里可以调节语速、音色与输出音量，然后即时试听。" />
          <DockPanel Grid.Row="2"><StackPanel Orientation="Horizontal"><Button x:Name="SpeakButton" Style="{StaticResource PrimaryButton}" Click="SpeakButton_Click" Margin="0,0,9,0"><StackPanel Orientation="Horizontal"><TextBlock Text="▶" Margin="0,0,7,0"/><TextBlock Text="开始试听"/></StackPanel></Button><Button Click="PauseButton_Click" Margin="0,0,9,0">暂停 / 继续</Button><Button Click="StopButton_Click">停止</Button></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="快速预设" Foreground="#69788C" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Padding="9,5" Margin="0,0,6,0" Click="NaturalPreset_Click">自然</Button><Button Padding="9,5" Margin="0,0,6,0" Click="AnnouncePreset_Click">播报</Button><Button Padding="9,5" Click="SlowPreset_Click">慢速</Button></StackPanel></DockPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Column="1">
        <Border Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,13">
          <StackPanel><DockPanel><TextBlock Text="声音设置" FontSize="15" FontWeight="Bold"/><TextBlock x:Name="VoiceCulture" DockPanel.Dock="Right" Foreground="#246BFD" FontSize="11" VerticalAlignment="Center"/></DockPanel><TextBlock Text="选择当前电脑可用的系统语音" Foreground="#69788C" FontSize="11" Margin="0,4,0,13"/>
            <TextBlock Text="音色" FontWeight="SemiBold" FontSize="12"/><ComboBox x:Name="VoiceSelector" Margin="0,7,0,17" SelectionChanged="VoiceSelector_SelectionChanged"/>
            <DockPanel Margin="0,0,0,3"><TextBlock Text="语速" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="RateValue" Text="正常" Foreground="#246BFD" FontSize="12" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="RateSlider" Minimum="-10" Maximum="10" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RateSlider_ValueChanged"/>
            <DockPanel Margin="0,15,0,3"><TextBlock Text="音高" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="PitchValue" Text="0%" Foreground="#246BFD" FontSize="12" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="PitchSlider" Minimum="-50" Maximum="50" Value="0" TickFrequency="10" ValueChanged="PitchSlider_ValueChanged"/>
            <DockPanel Margin="0,15,0,3"><TextBlock Text="输出音量" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="VolumeValue" Text="100% · 0.0 dBFS" Foreground="#246BFD" FontSize="12" DockPanel.Dock="Right"/></DockPanel><Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" ValueChanged="VolumeSlider_ValueChanged"/>
          </StackPanel>
        </Border>

        <Border Background="White" BorderBrush="#DCE7FF" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,13">
          <StackPanel><DockPanel><StackPanel><TextBlock Text="导出音频" FontSize="15" FontWeight="Bold"/><TextBlock Text="默认输出 MP3；WAV 适合无损保存或二次处理" Foreground="#69788C" FontSize="10" Margin="0,3,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#ECF2FF" Padding="8,4" CornerRadius="10"><TextBlock Text="离线" Foreground="#246BFD" FontSize="10" FontWeight="SemiBold"/></Border></DockPanel><Grid Margin="0,13,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="格式" Style="{StaticResource Caption}"/><ComboBox x:Name="ExportFormatSelector" SelectedIndex="0" SelectionChanged="ExportFormatSelector_SelectionChanged"><ComboBoxItem Content="MP3"/><ComboBoxItem Content="WAV"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="MP3 比特率" Style="{StaticResource Caption}"/><ComboBox x:Name="Mp3BitrateSelector" SelectedIndex="1"><ComboBoxItem Content="64 kbps"/><ComboBoxItem Content="96 kbps"/><ComboBoxItem Content="128 kbps"/><ComboBoxItem Content="192 kbps"/></ComboBox></StackPanel></Grid><TextBlock x:Name="ExportHint" Text="96 kbps 单声道：语音清晰、文件体积适中" Foreground="#69788C" FontSize="10" Margin="0,0,0,12"/><Button x:Name="ExportAudioButton" Style="{StaticResource PrimaryButton}" Click="ExportAudioButton_Click">导出 MP3 音频</Button></StackPanel>
        </Border>

        <Border Background="#10233F" CornerRadius="14" Padding="17"><StackPanel><TextBlock Text="试听与导出状态" Foreground="#9AAFD0" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="PlaybackStatus" Text="准备就绪" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,5,0,7"/><TextBlock Text="导出时会在后台生成音频，试听不会被中断。" Foreground="#B7C5DA" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Margin="0,18,0,0" Padding="13,10" Background="White" BorderBrush="#E7ECF3" BorderThickness="1" CornerRadius="10"><DockPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#16A36A" Margin="0,3,8,0"/><TextBlock Text="本机语音与编码服务就绪" FontSize="12" FontWeight="SemiBold"/></StackPanel><TextBlock DockPanel.Dock="Right" Text="MP3 为有损格式；WAV 保留 PCM 音频" Foreground="#69788C" FontSize="11"/></DockPanel></Border>
  </Grid>
</UserControl>
